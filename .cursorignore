# Prevent Cursor AI from reading files that may contain secrets.
# This stops the AI from indexing, reading, or displaying sensitive data in chat.

# Environment files with credentials
**/.env
**/.env.*
**/.env-*
**/env-*.secret

# CMS configuration files with database credentials
**/wp-config.php
**/config/config.php
**/config/parameters.yml
**/config/parameters.yaml

# Private keys and certificates
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks

# Credential files
**/credentials.*
**/secrets.*
**/*secret*.json
**/*secret*.yml
**/*secret*.yaml

# SSH keys
**/.ssh/

# Password files
**/.htpasswd
**/.netrc

# Token files
**/.token
**/*.token
